{
  "name": "nodejs-package-types",
  "version": "1.1.4",
  "description": "Customized Package Types",
  "packageManager": "yarn@3.6.3",
  "main": "index.js",
  "types": "typings/index.d.ts",
  "exports": {
    ".": "./index.js",
    "./hexo-bunyan": "./hexo-bunyan",
    "./through2": "./through2",
    "./typings": "./typings",
    "./src": "./src"
  },
  "files": [
    ".gitmodules",
    ".gitattributes",
    "*.json",
    "src",
    "typings",
    "skeljs/**/*.{js,ts,json,md}",
    "through2/**/*.{js,ts,json,md}",
    "hexo-bunyan/**/*.{js,ts,json,md}",
    "!**/node_modules/**",
    "!**/tmp/**",
    "!**/release/**"
  ],
  "scripts": {
    "update": "npx npm-check-updates -u",
    "pre-build": "git pull -X theirs",
    "build:through2": "npx fse copy packer.js through2/packer.js && cd through2 && npm run build",
    "build:types": "gulp",
    "build:tarball": "node packer.js && node unused.js",
    "build": "npm run pre-build && npm run build:through2 && npm run build:types && npm run build:tarball",
    "test": "cd test && npm run update && node setup.test.js",
    "clean": "npx -y rimraf tmp",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimaslanjaka/nodejs-package-types.git"
  },
  "keywords": [
    "types",
    "typescript",
    "markdown-it-abbr",
    "markdown-it-sup",
    "markdown-it-sub",
    "through2"
  ],
  "author": {
    "email": "dimaslanjaka@gmail.com",
    "name": "L3n40x",
    "url": "https://www.webmanajemen.com/about"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dimaslanjaka/nodejs-package-types/issues"
  },
  "homepage": "https://github.com/dimaslanjaka/nodejs-package-types#readme",
  "devDependencies": {
    "@atao60/fse-cli": "^0.1.9",
    "@dimaslanjaka/eslint-base-config": "^1.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/gulp": "^4.0.17",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.1.0",
    "binary-collections": "^2.0.11",
    "browser-sync": "^3.0.4",
    "depcheck": "^1.4.7",
    "express": "^5.1.0",
    "git-command-helper": "^2.1.0",
    "glob": "^11.0.3",
    "gulp": "^5.0.1",
    "husky": "^9.1.7",
    "jsonc-parser": "3.3.1",
    "lint-staged": "^17.0.5",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "npm-check-updates": "^18.0.2",
    "prettier": "3.8.3",
    "semver": "^7.7.2",
    "slugify": "^1.6.6",
    "typedoc": "^0.28.7",
    "typedoc-plugin-missing-exports": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@types/express": "^5.0.3",
    "@types/through2": "./through2",
    "ansi-colors": "^4.1.3",
    "axios": "^1.11.0",
    "cross-spawn": "https://github.com/dimaslanjaka/node-cross-spawn/raw/private/release/cross-spawn.tgz",
    "fs-extra": "^11.3.0",
    "hexo-util": "^3.3.0",
    "sbg-utility": "^2.0.8",
    "through2": "^4.0.2",
    "true-case-path": "^2.2.1",
    "upath": "^2.0.1"
  },
  "resolutions": {
    "sbg-utility": "https://github.com/dimaslanjaka/static-blog-generator/raw/44e5c7b79b4e60f8c2d34857c27b8ce677d7493e/packages/sbg-utility/release/sbg-utility.tgz",
    "git-command-helper": "https://github.com/dimaslanjaka/git-command-helper/raw/dd8c8ef596083f367c592f97a2439f9fc8ab33b2/release/git-command-helper.tgz",
    "cross-spawn": "https://github.com/dimaslanjaka/node-cross-spawn/raw/78b09a1f799430fb251c1b438ec56ce7957674f4/release/cross-spawn.tgz",
    "binary-collections": "https://github.com/dimaslanjaka/bin/raw/fa22222449a7b264007b326bc66007413dba1d4a/releases/bin.tgz",
    "@dimaslanjaka/eslint-base-config": "https://github.com/dimaslanjaka/eslint-base-config/raw/b1a58831e036760a51edbd8baf997e5a9e8a1c5b/release/dimaslanjaka-eslint-base-config.tgz"
  }
}
